li { margin:1.2mm 0; }
.lead { margin-bottom:7mm; color:#526059; font-size:12.5pt; line-height:1.55; }
.note, .callout, .warning, .success {
  margin:6mm 0; padding:5mm 5.5mm; border-radius:4mm; break-inside: avoid;
}
.note { border:1px solid #d7dfd9; background:#f7f9f7; }
.callout { border-left:4px solid #315d44; background:#f1f6f2; }
.warning { border-left:4px solid #a47b32; background:#fbf7ed; }
.success { border-left:4px solid #477456; background:#eef6f0; }
.note strong, .callout strong, .warning strong, .success strong { display:block; margin-bottom:1.5mm; }
.step-list { counter-reset: step; display:grid; gap:3mm; margin:5mm 0 7mm; }
.step {
  counter-increment: step; display:grid; grid-template-columns:11mm 1fr; gap:4mm;
  padding:4mm 4.5mm; border:1px solid #dce3de; border-radius:3mm; background:#fff; break-inside: avoid;
}
.step::before { content: counter(step); width:9mm; height:9mm; display:grid; place-items:center; border-radius:50%; color:#fff; background:#18221d; font-size:8pt; font-weight:900; }
.step strong { display:block; margin-bottom:1mm; }
.two-col { display:grid; grid-template-columns:1fr 1fr; gap:5mm; margin:5mm 0; }
.card { padding:5mm; border:1px solid #dce3de; border-radius:3mm; background:#fafbfa; break-inside:avoid; }
.card h3 { margin-top:0; }
.role-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:3mm; margin:5mm 0; }
.role { padding:4.5mm; border:1px solid #dce3de; border-radius:3mm; break-inside:avoid; }
.role strong { display:block; margin-bottom:2mm; font-size:11pt; }
.role.owner { background:#18221d; color:#fff; }
.role.owner p { color:#dce5df; }
.role.admin { background:#eef5ef; }
.role.member { background:#f7f8f7; }
table { width:100%; border-collapse:collapse; margin:4mm 0 6mm; font-size:9pt; break-inside:auto; }
thead { display:table-header-group; }
tr { page-break-inside:avoid; break-inside:avoid; }
th, td { padding:3mm 3.5mm; vertical-align:top; border:1px solid #d8dfda; }
th { background:#eef3ef; text-align:left; font-size:8.4pt; letter-spacing:.02em; }
.small { color:#6f7b74; font-size:8.6pt; }
#checklist .step-list { grid-template-columns: 1fr 1fr; gap: 2.5mm; }
#checklist .step { padding: 3mm 3.5mm; gap: 3mm; }
#checklist .step::before { width: 8mm; height: 8mm; font-size: 7.5pt; }
