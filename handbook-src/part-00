.cover-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:10mm; margin-top:20mm; }
.cover-grid div { border-top:1px solid #526158; padding-top:5mm; }
.cover-grid strong, .cover-grid span { display:block; }
.cover-grid strong { font-size:10pt; }
.cover-grid span { margin-top:2mm; color:#aebbb2; font-size:8.5pt; line-height:1.45; }
.cover-bottom { display:flex; justify-content:space-between; gap:20px; color:#9fada4; font-size:8.5pt; }
.content-page { padding: 20mm 18mm; }
.chapter { page-break-before: always; break-before: page; }
.chapter.first-after-cover { page-break-before: auto; break-before: auto; }
.chapter-label { margin-bottom:3mm; color:#567261; font-size:8pt; font-weight:900; letter-spacing:.14em; text-transform:uppercase; }
h1 { margin:0 0 5mm; font-size:24pt; line-height:1.08; letter-spacing:-.035em; }
h2 { margin:8mm 0 3mm; font-size:15pt; line-height:1.2; letter-spacing:-.02em; page-break-after: avoid; }
h3 { margin:6mm 0 2mm; font-size:11pt; line-height:1.3; page-break-after: avoid; }
p { margin:0 0 3.5mm; }
