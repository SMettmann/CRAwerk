<title>CRAwerk Handbuch - Version 2.0</title>
<style>
@page {
  size: A4;
  margin: 19mm 18mm 18mm 18mm;
  @bottom-left {
    content: "CRAwerk Handbuch  |  Stand September 2026";
    color: #748078;
    font-size: 8pt;
  }
  @bottom-right {
    content: "Seite " counter(page) " / " counter(pages);
    color: #748078;
    font-size: 8pt;
  }
}
@page :first {
  margin: 0;
  @bottom-left { content: none; }
  @bottom-right { content: none; }
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  color: #18221d;
  background: #eef2ee;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 10.3pt;
  line-height: 1.55;
}
a { color: #244d37; text-decoration: none; }
.manual-shell { max-width: 1180px; margin: 0 auto; background: #fff; }
.web-toolbar {
  position: sticky; top: 0; z-index: 20;
  display: flex; align-items: center; justify-content: space-between; gap: 16px;
  padding: 14px 28px; border-bottom: 1px solid #d8dfda; background: rgba(255,255,255,.96);
}
.web-toolbar .brand { font-weight: 900; font-size: 19px; letter-spacing: -.04em; color: #162019; }
.web-toolbar .brand span { color: #315d44; }
.web-actions { display:flex; gap:8px; flex-wrap:wrap; }
.web-actions a { display:inline-flex; align-items:center; min-height:36px; padding:0 13px; border:1px solid #cad3cc; border-radius:6px; font-size:10px; font-weight:800; color:#18221d; }
.web-actions .primary { color:#fff; background:#18221d; border-color:#18221d; }
.document { background:#fff; }
.cover {
  min-height: 297mm;
  padding: 32mm 24mm 24mm;
  display: flex; flex-direction: column; justify-content: space-between;
  color: #f7faf7;
  background: #18221d;
  page-break-after: always;
}
.cover-top { display:flex; align-items:center; justify-content:space-between; gap:30px; }
.cover-logo { font-size: 24pt; font-weight: 900; letter-spacing: -.05em; }
.cover-logo span { color:#a8c5b1; }
.cover-pill { padding:7px 11px; border:1px solid #617168; border-radius:999px; font-size:8.5pt; letter-spacing:.1em; text-transform:uppercase; color:#d7e1da; }
.cover-main { margin-top: 35mm; }
.cover-kicker { font-size: 9pt; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; color:#a8c5b1; }
.cover h1 { margin: 8mm 0 5mm; max-width: 150mm; font-size: 34pt; line-height:1.05; letter-spacing:-.045em; }
